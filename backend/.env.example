# Copier ce fichier en `.env` et renseigner des valeurs locales (ne jamais committer le .env réel)

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=changeme

# Clé de signature JWT — doit faire au moins 32 caractères (HS256 = 256 bits minimum).
# En dev, une valeur arbitraire suffit ; en prod, générer un secret fort.
JWT_SECRET=changeme-dev-secret-please-32-chars-min

# Identifiants du compte admin unique (pas de gestion multi-utilisateurs).
# ADMIN_PASSWORD_HASH est un hash bcrypt, jamais le mot de passe en clair.
# Le défaut ci-dessous correspond au mot de passe "changeme" — à changer en prod.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$hTnN/c/pa8yzMjhqjmYKtuytkXJIKBfGcJ5M3jvvvTNkKa4m9rqeC

# Origine autorisée pour CORS (URL du frontend en dev)
CORS_ALLOWED_ORIGIN=http://localhost:3000
